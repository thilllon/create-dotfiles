{
  "git": {
    "requireBranch": "main",
    "commit": false,
    "tag": true,
    "tagName": "v${version}",
    "push": false
  },
  "npm": {
    "publish": true,
    "skipChecks": true
  },
  "hooks": {
    "before:init": ["pnpm lint", "pnpm test"],
    "after:bump": "pnpm build",
    "after:release": "git push origin refs/tags/v${version}"
  }
}
