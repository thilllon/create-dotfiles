{
  "name": "create-dotfiles",
  "version": "3.2.1",
  "description": "Sync dotfiles between your home directory and a backup folder",
  "keywords": [
    "backup",
    "cli",
    "dotfiles",
    "sync"
  ],
  "homepage": "https://github.com/thilllon/create-dotfiles#readme",
  "bugs": {
    "url": "https://github.com/thilllon/create-dotfiles/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/thilllon/create-dotfiles"
  },
  "bin": {
    "create-dotfiles": "dist/cli.cjs"
  },
  "files": [
    "dist"
  ],
  "type": "commonjs",
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "types": "./dist/index.d.cts",
      "require": "./dist/index.cjs",
      "default": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "prepare": "lefthook install",
    "dev": "tsx src/cli.ts",
    "build": "tsdown",
    "start": "node dist/cli.cjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "oxlint --deny-warnings && oxfmt --check",
    "format": "oxfmt",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@clack/prompts": "1.9.0",
    "@types/node": "26.6.6",
    "@types/yazl": "3.3.1",
    "@vitest/coverage-v8": "4.1.11",
    "@zip.js/zip.js": "2.25.0",
    "cac": "7.1.0",
    "fflate": "0.8.3",
    "lefthook": "2.2.2",
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "smol-toml": "1.9.1",
    "tar": "7.5.23",
    "tsdown": "0.23.7",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "4.1.11",
    "yazl": "3.3.1"
  }
}
