{
  "name": "create-dotfiles",
  "version": "2.4.6",
  "description": "Sync dotfiles between your home directory and a backup folder",
  "keywords": [
    "backup",
    "cli",
    "dotfiles",
    "sync"
  ],
  "homepage": "https://github.com/thilllon/create-dotfiles#readme",
  "bugs": {
    "url": "https://github.com/thilllon/create-dotfiles/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/thilllon/create-dotfiles"
  },
  "bin": {
    "create-dotfiles": "dist/cli.cjs"
  },
  "files": [
    "dist"
  ],
  "type": "commonjs",
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "types": "./dist/index.d.cts",
      "require": "./dist/index.cjs",
      "default": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "prepare": "lefthook install",
    "dev": "tsx src/cli.ts",
    "build": "tsdown",
    "start": "node dist/cli.cjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "oxlint --deny-warnings && oxfmt --check",
    "format": "oxfmt",
    "typecheck": "tsc --noEmit",
    "release": "release-it"
  },
  "devDependencies": {
    "@clack/prompts": "1.8.1",
    "@types/node": "^26.4.1",
    "@types/yazl": "3.3.1",
    "@vitest/coverage-v8": "^4.1.11",
    "@zip.js/zip.js": "2.24.0",
    "cac": "^7.0.0",
    "fflate": "0.8.3",
    "lefthook": "2.2.2",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "release-it": "^21.0.2",
    "smol-toml": "^1.8.0",
    "tar": "^7.5.22",
    "tsdown": "^0.23.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "yazl": "3.3.1"
  }
}
