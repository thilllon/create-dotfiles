{
  "name": "create-dotfiles",
  "version": "2.3.0",
  "description": "Sync dotfiles between your home directory and a backup folder",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/thilllon/create-dotfiles"
  },
  "homepage": "https://github.com/thilllon/create-dotfiles#readme",
  "bugs": {
    "url": "https://github.com/thilllon/create-dotfiles/issues"
  },
  "type": "commonjs",
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "types": "./dist/index.d.cts",
      "require": "./dist/index.cjs",
      "default": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "create-dotfiles": "dist/cli.cjs"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "dotfiles",
    "sync",
    "backup",
    "cli"
  ],
  "scripts": {
    "prepare": "lefthook install",
    "dev": "tsx src/cli.ts",
    "build": "tsdown",
    "start": "node dist/cli.cjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "release": "release-it"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@clack/prompts": "1.7.0",
    "@types/node": "^26.4.1",
    "@types/yazl": "3.3.1",
    "@vitest/coverage-v8": "^4.1.11",
    "cac": "^7.0.0",
    "fflate": "0.8.3",
    "lefthook": "2.1.12",
    "release-it": "^21.0.2",
    "smol-toml": "^1.8.0",
    "tar": "^7.5.22",
    "tsdown": "^0.22.14",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11",
    "yazl": "3.3.1"
  }
}
